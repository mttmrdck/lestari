{
  "name": "lestari",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs http://localhost:8787 e2e-shots",
    "data:extract": "python3 scripts/extract_sources.py",
    "data:import": "tsx scripts/import-peribahasa.ts",
    "data:prpm": "python3 scripts/fetch_prpm_evidence.py",
    "design:lint": "npx @google/design.md lint DESIGN.md",
    "lint": "oxlint src scripts worker",
    "eval:situasi": "tsx scripts/eval/run.ts",
    "data:embed": "tsx scripts/build-embeddings.ts",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply lestari --local",
    "deploy": "npm run build && wrangler deploy",
    "supabase:check": "tsx scripts/check-supabase.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "2.118.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.89.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
