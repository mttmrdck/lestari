# Copy to .env.local (git-ignored) and fill in. `wrangler dev` and `vite build` both read it.
# The publishable key is safe in a browser only because Row Level Security protects the data.
# Never put a Supabase secret or service-role key here: NEXT_PUBLIC_ values ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
